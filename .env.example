# Choose one provider. Existing .env keys are never overwritten by setup.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional; provider URL and model names are inferred from the key.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# RAGAS_MODEL=openai/gpt-4o-mini
# RAGAS_EMBEDDING_MODEL=openai/text-embedding-3-small
API_TIMEOUT=60
ENRICHMENT_ENABLED=true
EVAL_ENABLED=true
GENERATION_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Explicit local test mode: QDRANT_LOCATION=:memory:
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_DEVICE=cpu
